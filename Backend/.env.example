# App Settings
APP_NAME=Konark Industry API
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=konark_industry

# For production use MongoDB Atlas free tier:
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=konarkindustrie@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=konarkindustrie@gmail.com
EMAIL_FROM_NAME=Konark Industry

# Company Info
COMPANY_NAME=Konark Industry
COMPANY_PHONE=+919437611129
COMPANY_EMAIL=konarkindustrie@gmail.com
COMPANY_ADDRESS=Bhimatangi Housing Colony, Bhubaneswar, Odisha 751002

# Admin Credentials
ADMIN_EMAIL=admin@konarkindustry.com
ADMIN_PASSWORD=generate-strong-password-here

# CORS - Frontend URLs allowed to call this API
FRONTEND_URL=https://konark-industry.vercel.app
ADMIN_URL=https://konark-admin.vercel.app
LOCAL_URL=http://localhost:3000
